<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="page">
  <div class="container">
    <div class="card card-pad empty" style="max-width:520px;margin-inline:auto">
      <span class="material-symbols-rounded" style="font-size:72px"><%= code === 404 ? 'search_off' : (code === 403 ? 'lock' : 'error') %></span>
      <h1 style="margin:10px 0 6px;font-size:2rem"><%= code %></h1>
      <p><%= message %></p>
      <a href="/" class="btn btn-primary" style="margin-top:12px"><span class="material-symbols-rounded">home</span> צוריק אַהיים</a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
